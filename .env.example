# Copy to .env. Nothing here is required for the retrieval half of the eval suite,
# which runs fully offline.

# --- Generation / LLM-judge (Ollama) ---
# 3B/q4 (~2GB) fits a 4GB card entirely. Raise to an 8B on a larger card - see the
# README on why a small judge means the generation numbers need validating.
RAGMED_OLLAMA_HOST=http://localhost:11434
RAGMED_GEN_MODEL=llama3.2:3b
RAGMED_JUDGE_MODEL=llama3.2:3b

# --- PubMed E-utilities ---
# Not required, but NCBI raises your rate limit from 3/s to 10/s if you supply one,
# and asks that you identify your tool and contact address.
RAGMED_NCBI_EMAIL=
RAGMED_NCBI_API_KEY=
RAGMED_NCBI_TOOL=ragmed

# --- Service ---
RAGMED_LOG_LEVEL=INFO
